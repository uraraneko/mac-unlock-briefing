# =============================================================================
# setup.config — 跨用户 / 跨设备可复现的安装与配置声明
# =============================================================================
# 用法（任意机器、任意用户）：
#   cd /path/to/todo-alert-mac
#   ./setup.sh
#   # 或指定配置：
#   ./setup.sh --config ./setup.config
#
# 本文件被 setup.sh source；使用 bash 赋值语法。路径可用 $HOME、$REPO_ROOT。
# 不要在此文件写本机绝对用户名路径；相对路径均相对仓库根目录。
# =============================================================================

# --- 包管理 / 运行时 ----------------------------------------------------------

# 是否通过 Homebrew 安装 Hammerspoon（cask）
INSTALL_HAMMERSPOON=true

# Homebrew cask 名称（一般无需改）
HAMMERSPOON_CASK="hammerspoon"

# 期望的 App 路径（Apple Silicon / Intel brew 均装到 /Applications）
HAMMERSPOON_APP="/Applications/Hammerspoon.app"

# 是否安装 Lua（仅用于本仓库自动化测试；真机弹窗不依赖）
INSTALL_LUA=true

# Lua formula 名称
LUA_FORMULA="lua"

# brew 不可用时是否失败退出（false 则跳过安装步骤并继续链接配置）
REQUIRE_BREW=true

# --- 配置目录与文件部署 --------------------------------------------------------

# Hammerspoon 配置目录（~ 会自动展开为当前用户 HOME）
HAMMERSPOON_CONFIG_DIR="${HOME}/.hammerspoon"

# 部署方式：symlink（改仓库即生效，推荐）| copy（独立副本）
DEPLOY_MODE="symlink"

# 部署到 HAMMERSPOON_CONFIG_DIR 的仓库内文件（空格分隔，相对 REPO_ROOT）
# content.json 为本地私有（gitignore），由 setup 从 content.example.json 生成
DEPLOY_FILES="init.lua config.lua briefing.lua content.json"
CONTENT_EXAMPLE="content.example.json"
CONTENT_FILE="content.json"

# 若目标已存在且不是指向本仓库的软链：backup（改名备份）| overwrite | skip
ON_EXISTING="backup"

# 备份后缀前缀（实际为 .bak.YYYYMMDDHHMMSS）
BACKUP_SUFFIX_PREFIX=".bak"

# --- 应用行为 -----------------------------------------------------------------

# 安装/部署后是否打开 Hammerspoon.app
OPEN_APP_AFTER_SETUP=true

# 是否尝试写入「登录时启动」（可能需本机授权；失败不阻断）
ENABLE_LAUNCH_AT_LOGIN=true

# 登录项显示名
LOGIN_ITEM_NAME="Hammerspoon"

# --- 校验 ---------------------------------------------------------------------

# 部署后是否检查必要文件存在
VERIFY_DEPLOY=true

# 是否在结束时打印辅助功能（Accessibility）手动步骤
PRINT_ACCESSIBILITY_HINT=true

# 是否运行仓库内自动化测试（需要 lua）
RUN_TESTS_AFTER_SETUP=false
